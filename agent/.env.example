
# Stellar network — testnet (default) or mainnet
STELLAR_NETWORK=testnet

# Agent Stellar keypair — must have testnet USDC balance
# Fund via Friendbot: https://friendbot.stellar.org?addr=G...
# Then manually add USDC trustline and fund from testnet faucet
AGENT_SECRET=S...

# Required for the MPP session step: openSession throws without it
# (any Ed25519 keypair secret)
COMMITMENT_SECRET=S...

# Optional: only used when the agent signs through the AgentVault contract
# account instead of a plain keypair (not read by agent/src/index.ts)
# AGENT_VAULT_CONTRACT_ID=CAX5IDLC2XHGQSEA2YN3LPLZ7EXLMRXYX3HFJGKFXS6B7OQXBKWO44LT

# Local daily spend cap for policy rejection demo.
# The documented run spends 0.001 (x402) + 0.0008 (MPP charge) + 50x0.0001
# (session vouchers) = 0.0068, and the rejection demo needs the next
# x402 (+0.001 = 0.0078) to exceed the cap — so the cap must sit in
# [0.0068, 0.0078). 0.002 (the old default) stops the session at voucher 3.
AGENT_DAILY_CAP_USDC=0.007

# Spend totals persist per UTC day in this file; a second run on the same day
# starts with the first run's spend already counted. Point at a fresh path
# (or delete the file) to reset before a re-run.
# AGENT_SPEND_STORE_PATH=./spend.json

# Provider URLs — deployed Worker URLs or local dev servers
# (local: wrangler dev on --port 3001 / --port 3002)
PROVIDER_A_URL=http://localhost:3001
PROVIDER_B_URL=http://localhost:3002

# Supabase — NOT read by agent/src/index.ts.
# Only agent/src/recover-sessions.ts uses these, with SUPABASE_SERVICE_KEY.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...
